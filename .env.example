# Copy to .env and source it (or let scripts/*.sh source it) before running anything.

# --- Postgres ---
PGHOST=localhost
PGPORT=55432
PGDATABASE=docpipeline
# Bootstrap admin, used only for running migrations.
PGUSER=postgres
PGPASSWORD=postgres

# App roles created by migrations/001_init.sql
PIPELINE_RW_USER=pipeline_rw
PIPELINE_RW_PASSWORD=pipeline_rw_pw
PIPELINE_RO_USER=pipeline_ro
PIPELINE_RO_PASSWORD=pipeline_ro_pw

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- GCS (fake-gcs-server) ---
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_BUCKET=docpipeline-local
GOOGLE_CLOUD_PROJECT=local-project

# --- Redis ---
REDIS_URL=redis://localhost:6380/0

# --- OCR engine: mock (default, deterministic) or tesseract (realism check) ---
OCR_ENGINE=deterministic
OCR_DPI=150

# --- Scaled-down local limits (see docpipeline/config.py for the full table) ---
SHARD_SIZE_PAGES=1
HARD_PAGE_CEILING=20
SWEEPER_BATCH_CAP=5
SWEEPER_CADENCE_SECONDS=30
STUCK_THRESHOLD_SECONDS=30
RELAY_POLL_SECONDS=2
RELAY_BATCH_CAP=50
ORPHAN_DETECTOR_INTERVAL_SECONDS=10
